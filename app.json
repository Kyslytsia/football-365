{
  "expo": {
    "name": "football-365",
    "slug": "football-365",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "transparent"
    },
    "packagerOpts": {
      "sourceExts": ["js", "jsx", "svg"],
      "transformer": "node_modules/react-native-svg-transformer/index.js"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "transparent"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "5f910142-99eb-486b-9548-9368fe8a6a62"
      }
    },
    "owner": "denys89",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/5f910142-99eb-486b-9548-9368fe8a6a62"
    }
  }
}
